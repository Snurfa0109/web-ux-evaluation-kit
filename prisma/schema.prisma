generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  @@map("admin_users")
}

model Participant {
  id                          Int      @id @default(autoincrement())
  participantCode             String   @unique
  name                        String
  age                         Int
  gender                      String
  occupation                  String
  governmentWebsiteExperience Boolean
  disnakertransExperience     Boolean
  whatsappNumber              String?
  createdAt                   DateTime @default(now())

  susResponses       SusResponse[]
  ueqResponses       UeqResponse[]
  uatTaskResponses   UatTaskResponse[]
  uatOverallFeedback UatOverallFeedback[]

  @@map("participants")
}

model StudyPhase {
  id              Int      @id @default(autoincrement())
  phaseNumber     Int      @unique
  phaseName       String
  instrument      String
  status          String   @default("DRAFT")
  startDate       DateTime?
  endDate         DateTime?
  participantMode String   @default("SAME_ONLY")
  externalUrl     String?
  instructions    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks              PhaseTask[]
  susResponses       SusResponse[]
  ueqResponses       UeqResponse[]
  uatTaskResponses   UatTaskResponse[]
  uatOverallFeedback UatOverallFeedback[]

  @@map("study_phases")
}

model PhaseTask {
  id                 Int      @id @default(autoincrement())
  phaseId            Int
  taskCode           String
  feature            String?
  title              String
  description        String   @db.Text
  expectedResult     String?  @db.Text
  acceptanceCriteria String?  @db.Text
  order              Int      @default(0)
  createdAt          DateTime @default(now())

  phase            StudyPhase        @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  uatTaskResponses UatTaskResponse[]

  @@map("phase_tasks")
}

model SusResponse {
  id            Int      @id @default(autoincrement())
  participantId Int
  phaseId       Int
  q1            Int
  q2            Int
  q3            Int
  q4            Int
  q5            Int
  q6            Int
  q7            Int
  q8            Int
  q9            Int
  q10           Int
  susScore      Float
  // Feedback kualitatif
  fb1           String?  @db.Text // Fitur paling mudah
  fb2           String?  @db.Text // Fitur sulit/membingungkan
  fb3           String?  @db.Text // Informasi sulit ditemukan
  fb4           String?  @db.Text // Saran fitur/informasi
  fb5           String?  @db.Text // Saran umum
  fb6           String?  // Bersedia lanjutan (Ya/Tidak)
  fb6Phone      String?  // Nomor WhatsApp/HP untuk partisipasi lanjutan
  completedAt   DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  phase       StudyPhase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([participantId, phaseId])
  @@map("sus_responses")
}

model UeqResponse {
  id             Int      @id @default(autoincrement())
  participantId  Int
  phaseId        Int
  item1          Int
  item2          Int
  item3          Int
  item4          Int
  item5          Int
  item6          Int
  item7          Int
  item8          Int
  item9          Int
  item10         Int
  item11         Int
  item12         Int
  item13         Int
  item14         Int
  item15         Int
  item16         Int
  item17         Int
  item18         Int
  item19         Int
  item20         Int
  item21         Int
  item22         Int
  item23         Int
  item24         Int
  item25         Int
  item26         Int
  attractiveness Float
  perspicuity    Float
  efficiency     Float
  dependability  Float
  stimulation    Float
  novelty        Float
  // Feedback kualitatif
  fb1           String?  @db.Text // Bagian visual disukai
  fb2           String?  @db.Text // Bagian membingungkan/kurang nyaman
  fb3           String?  @db.Text // Saran perbaikan prototype
  fb4           String?  // Bersedia UAT (Ya/Tidak)
  fb4Phone      String?  // Nomor WhatsApp/HP
  completedAt    DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  phase       StudyPhase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([participantId, phaseId])
  @@map("ueq_responses")
}

model UatTaskResponse {
  id            Int      @id @default(autoincrement())
  participantId Int
  phaseId       Int
  taskId        Int
  status        String
  notes         String?  @db.Text
  completedAt   DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  phase       StudyPhase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  task        PhaseTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([participantId, phaseId, taskId])
  @@map("uat_task_responses")
}

model UatOverallFeedback {
  id            Int      @id @default(autoincrement())
  participantId Int
  phaseId       Int
  rating1       Int
  rating2       Int
  rating3       Int
  rating4       Int?
  rating5       Int?
  meanRating    Float
  // Feedback kualitatif
  fb1           String?  @db.Text // Kesesuaian fungsi & layanan
  fb2           String?  @db.Text // Kendala / bug ditemukan
  fb3           String?  @db.Text // Saran & kritik penerapan final
  completedAt   DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  phase       StudyPhase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([participantId, phaseId])
  @@map("uat_overall_feedback")
}

